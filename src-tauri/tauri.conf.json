{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Z-Flix Launcher",
  "version": "0.1.0",
  "identifier": "com.zflix.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Z-Flix Launcher",
        "width": 1180,
        "height": 700,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["French"],
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3MDQ0MEU2QTg4OEVCMDYKUldRRzY0aW81a0FFWitZcEUxQVVURTVnRG9WRURhSUkwL0x5aHRvenhzQ2pJaFVUS1dLMFhiSEUK",
      "endpoints": [
        "https://github.com/Apnkk/zflix-launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
